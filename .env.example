# Copy to .env and fill in. .env is git ignored; never commit real passwords.

# Address people open the app at. Used in the links inside emails.
G4S_BASE_URL=http://localhost:3000

# Email sender. For Gmail: turn on 2 Step Verification on the sender account,
# then create an App password at https://myaccount.google.com/apppasswords
G4S_SMTP_HOST=smtp.gmail.com
G4S_SMTP_PORT=465
G4S_SMTP_USER=oneringprotocol@gmail.com
G4S_SMTP_PASS=

# GPS source: xlsx (sheets/Route_*.xlsx) or totalsecure (platform API).
G4S_GPS_SOURCE=xlsx
# Total Secure API token. Make one with: python3 -m app.totalsecure token
# Never put the platform password here.
G4S_TS_TOKEN=
# Days to load: today plus G4S_TS_DAYS before it, or a fixed span G4S_TS_FROM..G4S_TS_TO (YYYY-MM-DD).
G4S_TS_DAYS=7
# G4S_TS_FROM=2026-10-11
# G4S_TS_TO=2026-10-17
